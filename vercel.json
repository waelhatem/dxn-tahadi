{
  "functions": {
    "api/rpc.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/push-cron",
      "schedule": "0 8 * * *"
    }
  ],
  "headers": [
    {
      "source": "/app/index.html",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'self'"
        }
      ]
    }
  ]
}

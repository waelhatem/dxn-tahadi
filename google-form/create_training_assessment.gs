/**
 * إنشاء Google Form الحقيقي لاختبار الحقيبة التدريبية.
 * شغّل createTrainingAssessmentForm() مرة واحدة من Google Apps Script
 * داخل حساب Google الذي سيملك النموذج. سيظهر رابط التعديل ورابط الإجابة في سجل التنفيذ.
 */
function createTrainingAssessmentForm(){
  const form=FormApp.create('اختبار الحقيبة التدريبية — التقييم الآلي');
  form.setDescription('اختبار من 12 سؤالًا. الإجابات تُستخدم للتقييم الآلي ومقارنة الفهم بالإجابة المرجعية.');
  form.setConfirmationMessage('تم إرسال الإجابات. سيتم تقييمها آليًا.');
  form.setCollectEmail(false);
  form.addTextItem().setTitle('Sponsor Email').setRequired(true);
  const qs=[["س/1 ماهي ال4 نصائح للاستفادة القصوى من الحقيبة التدريبية ؟","النصيحة الأولى: التدرج في سماع المادة التدريبية بحسب تسلسل الحقيبة لأن المعلومات فيها متسلسلة بشكل تصاعدي. النصيحة الثانية: المادة مختصرة لتناسب العضو الجديد وهناك شروحات مفصلة يمكن الاستعانة بها لاحقًا. النصيحة الثالثة: عند صعوبة فهم معلومة يرجع العضو إلى الشخص الذي سجله ضمن المشروع. النصيحة الرابعة: الجلوس في مكان هادئ وبعيد عن المشتتات عند سماع الحقيبة."],["س/2 ماهي المشاريع الذكية وماهي صفاتها ؟","هي مشاريع تعتمد على فكرة ذكية من صاحبها، وقد لا تحتاج إلى رأس مال، وتتيح تحديد الوقت والمكان المناسبين للعمل، ويمكن أن توفر دخلًا حتى أثناء النوم، ويمكن إدارتها من الهاتف ولا تتعارض مع الالتزامات الأخرى ولا تتطلب اشتراطات معقدة."],["س/3 ما هو البيع المباشر نظام شركة دي اكس ان وماهي مزاياه ؟","هو عملية بيع المنتج من المصنع إلى المستهلك مباشرة الذي يسمى الموزع دون تاجر وسيط، وعادة من خلال الدعاية الشفهية والسيستم الخاص بالموزع. ومن مزاياه زيادة الدخل، المرونة في العمل، أن تكون مدير نفسك، وبناء علاقات عابرة للقارات."],["س/4 الفرق بين البيع المباشر والبيع التقليدي ؟","في البيع التقليدي تمر السلعة عبر مراحل ووسطاء مثل الوكيل الإقليمي ووكيل الدولة وموزع الجملة والتاجر قبل المستهلك، بينما أُوجد البيع المباشر لتقليل الوساطة بحيث ينتقل جزء من هذه القيمة للمستهلك/الموزع ليستفيد منها. ويمكن للجميع العمل فيه بغض النظر عن الشهادة أو الخبرة، ووفق المادة هو بدون رأس مال."],["س/5 ماهي عناصر قوة شركة دي اكس ان ؟","شركة حقيقية عالمية تجاوز عمرها 30 عامًا، منتشرة رسميًا في أكثر من 80 دولة ويعمل معها أكثر من 18 مليون عضو، وتمتلك مزارع ومصانع في عدد من الدول وتقوم بزراعة وصناعة المنتجات وتوزيعها في أكثر من 180 بلدًا."],["س/6 ماهي اصناف منتجات دي اكس ان ؟","أربعة أصناف: المأكولات الغذائية الطبيعية، المشروبات والعصائر الطبيعية، منتجات العناية الشخصية، ومنتجات العناية بالبشرة والتجميل."],["س/7 ماهي مميزات العمل مع دي اكس ان ؟","عضوية مجانية عالمية، سيستم إلكتروني يدير العملية التسويقية، نظام ربح عالمي لا محلي فقط، نظام التوريث للأولاد بعد عمر طويل، وتدريبات شخصية وعملية مجانية للبدء بالمشروع."],["س/8 ماهي طرق الربح من دي اكس ان للاستفادة المالية ؟","ثلاث طرق: استهلاكك الشخصي، البيع بالتجزئة، وبناء فريق مبيعات."],["س/9 ماهي مميزات منتجات دي اكس ان ؟","منتجات طبيعية وعضوية ذات جودة عالية وحاصلة على شهادات عالمية بهذا الخصوص؛ تقدم قيمة حقيقية للمستهلك؛ ومتنوعة تغطي أغلب حاجات الاستهلاك اليومي مثل القهوة والشاي والشامبو والصابون ومعجون الأسنان والزيوت والكريمات."],["س/10 ماهو الفرق بين الPV و الSV ؟","PV هو VALLU POINT أي القيمة النقطية للمنتج، وSV هو VALLU SALES أي القيمة الربحية للمنتج. كل منتج يحتوي على PV وSV، وبقدر تحقيق المبيعات ترتفع النقاط وترتفع معها نسبة العمولة والأرباح."],["س/11 كيف تصل في الدي اكس ان الى مرتبة النجم ثم الياقوتي ثم الماسي ؟","عند بلوغ 4500 نقطة تراكمية يصل العضو إلى رتبة الوكيل النجم، ثم عند وصول ثلاثة أعضاء بخطوط أفقية مختلفة إلى رتبة الوكيل النجم يصبح نجمًا ياقوتيًا، ثم عند وصول ستة أعضاء بخطوط أفقية مختلفة إلى رتبة الوكيل النجم يصبح نجمًا ماسيًا، وفق الأرقام والنسب الواردة في المادة."],["س/12 ماهي خطوات العمل الاحترافي للنجاح مع دي اكس ان ؟","الانضمام للعضوية وتفعيلها وتحقيق مبيعات بمقدار 100 نقطة تقريبًا؛ استخدام بعض المنتجات لتلمس فوائدها؛ التعلم قبل الكلام وفهم الشركة والمنتجات والخطة المالية؛ كتابة قائمة المعارف وتصنيفها إلى سوق بارد ودافئ ثم السوشيال ميديا؛ وضع خطة للاستقطاب؛ عرض العمل باحتراف أو الاستعانة بالسبونسر؛ تسجيل الراغبين وتعريف العضو الجديد بمزايا العضوية؛ المتابعة الصحيحة؛ الاستنساخ والمضاعفة؛ ثم تدريب الفريق على الخطوات السابقة."]];
  qs.forEach((q)=>form.addParagraphTextItem().setTitle(q[0]).setHelpText('الإجابة المرجعية محفوظة في النظام للتقييم الآلي.').setRequired(true));
  Logger.log(JSON.stringify({editUrl:form.getEditUrl(),publishedUrl:form.getPublishedUrl(),formId:form.getId()}));
}
